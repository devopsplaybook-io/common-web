{
  "name": "@devopsplaybook.io/common-web",
  "version": "0.2.0",
  "description": "Shared Nuxt layer for DevOpsPlaybook web applications",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./components/*",
    "./composables/*": "./composables/*",
    "./services/*": "./services/*",
    "./stores/*": "./stores/*"
  },
  "files": [
    "nuxt.config.ts",
    "assets",
    "components",
    "composables",
    "services",
    "stores",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "lint": "oxlint components composables services stores tests scripts playground vitest.config.ts nuxt.config.ts",
    "test": "node scripts/test-packed.mjs",
    "build": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "pinia": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.1",
    "nuxt": "4.5.2",
    "oxlint": "^1.85.0",
    "pinia": "^4.0.3",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
