{
  "name": "@devopsplaybook.io/common-web",
  "version": "0.12.0",
  "description": "Shared Nuxt layer for DevOpsPlaybook web applications",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopsplaybook-io/common-web.git"
  },
  "homepage": "https://github.com/devopsplaybook-io/common-web#readme",
  "bugs": "https://github.com/devopsplaybook-io/common-web/issues",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./components/*",
    "./composables/*": "./composables/*",
    "./services/*": "./services/*",
    "./stores/*": "./stores/*"
  },
  "files": [
    "nuxt.config.ts",
    "assets",
    "components",
    "composables",
    "services",
    "stores",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "lint": "oxlint components composables services stores tests scripts playground vitest.config.ts nuxt.config.ts",
    "typecheck": "nuxi typecheck",
    "pretest": "nuxi prepare",
    "test": "node scripts/test-packed.mjs",
    "prebuild": "nuxi prepare",
    "build": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "pinia": "^2.0.0 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.21.0",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "nuxt": "^4.6.3",
    "oxlint": "^1.90.0",
    "pinia": "^4.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
