{
  "name": "@devopsplaybook.io/common-web",
  "version": "0.16.2",
  "description": "Shared Nuxt layer for DevOpsPlaybook web applications",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devopsplaybook-io/common-web.git"
  },
  "homepage": "https://github.com/devopsplaybook-io/common-web#readme",
  "bugs": "https://github.com/devopsplaybook-io/common-web/issues",
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./components/*": "./components/*",
    "./composables/*": "./composables/*",
    "./services/*": "./services/*",
    "./stores/*": "./stores/*"
  },
  "files": [
    "nuxt.config.ts",
    "assets",
    "components",
    "composables",
    "services",
    "stores",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nuxi dev playground",
    "lint": "oxlint components composables services stores tests scripts playground e2e vitest.config.ts nuxt.config.ts playwright.config.ts",
    "typecheck": "nuxi typecheck",
    "pretest": "nuxi prepare",
    "test": "node scripts/test-packed.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "prebuild": "nuxi prepare",
    "build": "node scripts/build-package.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "pinia": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.21.1",
    "jwt-decode": "^4.0.0",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "nuxt": "^4.7.0",
    "oxlint": "^1.95.0",
    "pinia": "^4.1.0",
    "postcss": "^8.5.33",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
